# Normalize source files without modifying checked-in binary fixtures
* text=auto
*.py text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.exe binary
*.dll binary
*.o binary
*.obj binary
*.a binary
*.pgrnn binary
*.zip binary
# Large, curated corpora are versioned but not line-diffed
BD/datasets/**/*.jsonl -diff
BD/observations/**/*.jsonl -diff
BD/catalog/projects.jsonl -diff
# Historical manifests hash raw bytes: preserve these imported CRLF snapshots.
BD/catalog/projects.csv -text
BD/reports/collection/gcc_report.json -text
NN/diagnostics/docs/previous_windows_challenge_summary.json -text
NN/diagnostics/docs/previous_windows_rule_summary.json -text
